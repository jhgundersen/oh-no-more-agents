{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oh-no-more-agents",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "oh-no-more-agents.com",
      "custom_domain": true
    },
    {
      "pattern": "www.oh-no-more-agents.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oh-no-more-agents",
      "database_id": "e87e6ae5-35c6-4bc4-b318-3728bbd881ff",
      "migrations_dir": "migrations"
    }
  ]
}
