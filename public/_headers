# Workers Assets reads this file instead of serving it. Its only job is to undo
# the default `cache-control: public, max-age=0, must-revalidate` for the
# kinds of file that are safe to keep forever.

# Bare /agents/*.js (including ?v= source URLs) deliberately use the default
# revalidation policy. tools/ship.js appends exact immutable rules to dist/
# only for the content-hashed JavaScript filenames referenced by its page.

# 24 MB of soundtrack that has no stamp, so this one is a promise we keep by
# hand: a replacement track gets a new number, it does not overwrite an old one.
/agents/*.mp3
  cache-control: public, max-age=31536000, immutable

# Numbered share artwork and icons are immutable too. A replacement gets a
# new number and new links; never overwrite an already published PNG.
/share-*.png
  cache-control: public, max-age=31536000, immutable
/favicon-*.png
  cache-control: public, max-age=31536000, immutable
/apple-touch-icon-*.png
  cache-control: public, max-age=31536000, immutable

# The page's pixel font (docs/fonts.md). Numbered like the artwork: a new cut
# gets a new name, so the old one can be cached for good.
/fonts/*.woff2
  cache-control: public, max-age=31536000, immutable
